{
  "expo": {
    "name": "Dak-reporting-app",
    "slug": "Dak-reporting-app",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/clf-icon.png",
    "scheme": "dakreportingapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/clf-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#24634F",
        "foregroundImage": "./assets/images/clf-icon-foreground.png",
        "monochromeImage": "./assets/images/clf-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/clf-favicon.png",
      "name": "CLF Foolmala Jeevika",
      "shortName": "Foolmala"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F6F1"
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
